---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const base = import.meta.env.BASE_URL;

const projects = [
  {
    title: 'Nail Order',
    description: `Expo/React Native commerce app for a UK nail-pro brand. Shop and checkout via Shopify Storefront and Customer Account APIs (Apollo), with Firebase-backed features including wishlist, client consultations, restock alerts, and an in-app pricing calculator.`,
    previewType: 'image' as const,
    previews: [
      `${base}projects/nail-order/home.png`,
      `${base}projects/nail-order/shop.png`,
      `${base}projects/nail-order/product.png`,
      `${base}projects/nail-order/cart.png`,
      `${base}projects/nail-order/calculator.png`,
      `${base}projects/nail-order/consultation.png`,
    ],
    ghRepo: '',
    links: [
      {
        label: 'App Store',
        href: 'https://apps.apple.com/gb/app/nail-order/id6742821751',
      },
      {
        label: 'Play Store',
        href: 'https://play.google.com/store/apps/details?id=com.nailorder.NOapp&hl=en',
      },
    ],
    techIcons: [
      'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/expo/expo-original-wordmark.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/graphql/graphql-plain.svg',
      'https://res.cloudinary.com/dgclfs5cd/image/upload/f_auto,q_auto/tcjvasc3one2l0pjv1s6',
      'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/firebase/firebase-plain-wordmark.svg',
    ],
  },
  {
    title: 'Nail Order Shopify Theme',
    description: `Custom Shopify Liquid theme work (Lorenza base) for a UK nail-pro brand. Added NO-prefixed snippets and sections for free-shipping progress, VAT price toggle, metaobject sale campaigns, YouTube facade / video hero, gel-chart metafields, and a customer stock-room page—keeping core theme diffs minimal for safer upgrades. Also tackled Core Web Vitals (CLS and LCP) to pass performance tests, plus SEO improvements including JSON-LD structured data.`,
    previewType: 'image' as const,
    previews: [
      `${base}projects/nail-order-theme/home.png`,
      `${base}projects/nail-order-theme/collection.png`,
      `${base}projects/nail-order-theme/stock-room.png`,
      `${base}projects/nail-order-theme/wishlists.png`,
    ],
    ghRepo: '',
    link: 'https://nailorder.co.uk',
    techIcons: [
      'https://res.cloudinary.com/dgclfs5cd/image/upload/f_auto,q_auto/tcjvasc3one2l0pjv1s6',
      'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-plain-wordmark.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-plain-wordmark.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg',
    ],
  },
  {
    title: 'galore platform front-end',
    description: `Front-end for galore's digital passport experience for luxury handbags. Built with Vite, React, and TypeScript; MapLibre maps for provenance and chain of custody, plus service history, care guides, and item storytelling. Styled with Tailwind CSS.`,
    previewType: 'image' as const,
    previews: [
      `${base}projects/galore-platform/handbag.png`,
      `${base}projects/galore-platform/chain-of-custody.png`,
      `${base}projects/galore-platform/origin.png`,
      `${base}projects/galore-platform/service-history.png`,
      `${base}projects/galore-platform/care-guide.png`,
    ],
    ghRepo: '',
    link: 'https://galore.club',
    techIcons: [
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vitejs/vitejs-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg',
      'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg',
    ],
  },
];
---

<BaseLayout title="Projects | Bee-jay Paiz" description="Recent web development projects.">
  <Header slot="header" />
  <div class="pb-16 pt-10">
    <h1 class="text-3xl font-semibold tracking-tight text-chatelle-50">Projects</h1>
    <p class="mt-2 max-w-xl text-sm text-mountain-mist-400">Selected client and personal work.</p>
    <div class="mt-14 flex max-w-3xl flex-col">
      {
        projects.map((project, i) => (
          <article
            class:list={[
              'flex flex-col gap-5 py-12',
              i > 0 && 'border-t border-mountain-mist-900',
            ]}
          >
            <div class="flex flex-wrap items-start justify-between gap-4">
              <h2 class="text-lg font-medium text-chatelle-50">{project.title}</h2>
              <div class="flex items-center gap-3">
                {project.ghRepo ? (
                  <a
                    href={project.ghRepo}
                    target="_blank"
                    rel="noreferrer"
                    class="text-mountain-mist-400 transition hover:text-eucalyptus-400"
                    aria-label="GitHub"
                  >
                    <img
                      src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg"
                      alt=""
                      class="h-5 w-5 opacity-80 invert"
                      width="20"
                      height="20"
                    />
                  </a>
                ) : null}
                {'links' in project && project.links ? (
                  project.links.map((item) => (
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center gap-1 text-sm text-eucalyptus-400 transition hover:text-eucalyptus-300"
                    >
                      {item.label}
                      <span class="material-symbols-outlined text-base">arrow_outward</span>
                    </a>
                  ))
                ) : 'link' in project && project.link ? (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-1 text-sm text-eucalyptus-400 transition hover:text-eucalyptus-300"
                    aria-label="Open project"
                  >
                    Visit
                    <span class="material-symbols-outlined text-base">arrow_outward</span>
                  </a>
                ) : null}
              </div>
            </div>
            {'previewType' in project && project.previewType === 'image' && 'previews' in project ? (
              <div class="flex gap-3 overflow-x-auto border border-mountain-mist-900 p-3">
                {project.previews.map((src) => (
                  <img
                    src={src}
                    alt={`${project.title} screenshot`}
                    class="h-72 w-auto shrink-0 rounded-sm object-contain"
                    loading="lazy"
                    width="160"
                    height="288"
                  />
                ))}
              </div>
            ) : 'preview' in project && project.preview ? (
              <div class="overflow-hidden border border-mountain-mist-900">
                <video src={project.preview} autoplay loop muted playsinline class="w-full" />
              </div>
            ) : null}
            <p class="text-sm leading-relaxed text-mountain-mist-300">{project.description}</p>
            <div class="flex flex-wrap gap-3 opacity-90">
              {project.techIcons.map((icon) => (
                <img src={icon} alt="" class="h-8 w-auto object-contain grayscale" width="40" height="40" />
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
  <Footer slot="footer" />
</BaseLayout>
